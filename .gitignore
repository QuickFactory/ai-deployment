# ==========================================
# 1. Environment and Secrets Profiles
# ==========================================
# Block all live local environment files containing real API keys
.env
.env.production
.env.local

# Allow the tracking example template to stay visible to users
!.env.example

api-keys.txt
# ==========================================
# 2. Generated at deploy time (contain live client keys / internal token)
# ==========================================
nginx-conf/api-keys.conf
nginx-conf/vhost.d/

# Runtime data (symlinks to /mnt/ai-volume or local_data)
local_data/
hermes_data
rag_data
searxng
librechat_data
mongo_data
postgres_data
ingest

# ==========================================
# 3. Web Proxy, Cache, and SSL Footprints
# ==========================================
# Prevent security keys or Let's Encrypt certificates from tracking
certs/
vhost.d/
html/
acme/

# ==========================================
# 4. Standard OS and Editor Remnants
# ==========================================
# System Specifics
.DS_Store
Thumbs.db

# Workspace Specifics
.idea/
.vscode/
*.swp
*.log
