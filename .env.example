# .env Configuration Guide
# Normally generated for you by deploy.sh / configure-ai.
# Do NOT commit a real .env — this file is a reference template only.

# ---- Public domains (one DuckDNS subdomain per vhost) ----
AI_DOMAIN=my-hermes.duckdns.org            # Hermes dashboard
API_DOMAIN=my-hermes-api.duckdns.org       # Hermes OpenAI-compatible API

# ---- Certificates / DNS ----
LETSENCRYPT_EMAIL=your-email@provider.com
DUCKDNS_SUBDOMAINS=my-hermes,my-hermes-api # comma list, names only (no .duckdns.org)
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Providers ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxx

# ---- Internal secrets (auto-generated; never expose) ----
# HERMES_INTERNAL_TOKEN: the single key Hermes' API server accepts.
# Public clients use one of the 5 nginx-issued keys instead (api-keys.txt);
# nginx swaps them for this token in transit.
HERMES_INTERNAL_TOKEN=generated-by-setup
RAG_INTERNAL_API_KEY=generated-by-setup
POSTGRES_DB_PASSWORD=generated-by-setup

# ---- Document ingestion (folder-drop RAG with OCR) ----
OCR_LANGUAGES=eng                          # Tesseract langs, e.g. eng+deu
INGEST_POLL_INTERVAL=20                    # seconds between inbox scans

# ---- Optional integrations ----
DISCORD_BOT_TOKEN=change_me_if_needed
DISCORD_CHANNEL_ID=change_me_if_needed

# ---- Optional LibreChat frontend ----
# Uncomment to enable (or answer "y" during setup):
#COMPOSE_PROFILES=librechat
#LIBRECHAT_DOMAIN=my-hermes-chat.duckdns.org
#LIBRECHAT_JWT_SECRET=generated-by-setup
#LIBRECHAT_JWT_REFRESH_SECRET=generated-by-setup
